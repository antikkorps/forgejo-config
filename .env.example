# --- Forgejo ---
FORGEJO_DOMAIN=git.fvienot.link

# --- Postgres ---
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=CHANGE_ME_long_random_string

# --- Resend (SMTP) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM=git@fvienot.link

# --- Caddy / Let's Encrypt ---
# ACME account email (used for renewal notices from Let's Encrypt).
# Cloudflare DNS for FORGEJO_DOMAIN must be in DNS-only mode (grey cloud)
# so Caddy can complete the HTTP-01/TLS-ALPN challenge.
ACME_EMAIL=you@example.com

# --- Restic / R2 backups ---
# Create an R2 bucket + API token (S3 compatible) in Cloudflare dashboard
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/forgejo-backups
RESTIC_PASSWORD=CHANGE_ME_long_random_string_KEEP_SAFE
AWS_ACCESS_KEY_ID=r2_access_key_id
AWS_SECRET_ACCESS_KEY=r2_secret_access_key

# --- Healthchecks.io ---
# Create a check at healthchecks.io and paste its ping URL here
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Optional: separate check for the monthly restore test (otherwise reuses HEALTHCHECK_URL)
RESTORE_TEST_HEALTHCHECK_URL=https://hc-ping.com/your-restore-test-uuid

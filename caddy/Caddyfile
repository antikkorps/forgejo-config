# Caddy terminates TLS directly (Let's Encrypt via HTTP-01/TLS-ALPN).
# Cloudflare DNS for {$FORGEJO_DOMAIN} must be in DNS-only mode (grey cloud)
# so the ACME challenge reaches this server.

{
	email {$ACME_EMAIL}
}

{$FORGEJO_DOMAIN} {
	encode zstd gzip

	# Larger uploads for git push / LFS
	request_body {
		max_size 500MB
	}

	reverse_proxy forgejo:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
